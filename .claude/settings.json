      "Bash(kubectl -n omicz-dev-ns:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.llm)"
    ]
  }
}
