# Copy to .env (gitignored) and fill in. Never commit .env, never paste the key into chats or issues.

# LLM – e-INFRA CZ service (OpenAI-compatible). Key: chat.ai.e-infra.cz → Settings → Account → API keys
LLM_BASE_URL=https://llm.ai.e-infra.cz/v1
LLM_API_KEY=
# Pick after running `make eval-llm`. Aliases (agentic/coder/mini/thinker) survive model rotation.
LLM_MODEL_FAST=agentic
LLM_MODEL_CODE=coder

# Where results bundles live locally (default: ./data). Can point to a synced shared-drive folder, e.g.
# AIBEX_DATA_DIR="/path/to/AIBEX/data"
AIBEX_DATA_DIR=
